# Copy to .env or let the setup scripts create .env for you.
# .env is local-only and should not be committed.

# GitHub personal access token with repo scope.
GITHUB_TOKEN=


# Git identity — used for commits on the remote instance.
GIT_AUTHOR_NAME=""
GIT_AUTHOR_EMAIL=""

# Weights & Biases API key — passed into the Isaac Lab container for experiment tracking.
WANDB_API_KEY=