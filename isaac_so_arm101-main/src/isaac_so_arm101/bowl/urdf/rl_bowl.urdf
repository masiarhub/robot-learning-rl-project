<?xml version="1.0"?>
<robot name="rl_bowl">

  <link name="bowl_base">
    <visual>
      <origin xyz="0 0 0.003" rpy="0 0 0"/>
      <!-- scale converts mm → m -->
      <geometry>
        <mesh filename="rl_bowl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="bowl_white">
        <color rgba="0.95 0.95 0.95 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.003" rpy="0 0 0"/>
      <geometry>
        <mesh filename="rl_bowl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <!-- ~200g bowl, approximated as solid cylinder for inertia -->
      <!-- r=0.078m, h=0.057m, m=0.2kg -->
      <!-- Ixx = Iyy = m/12*(3r^2+h^2) = 0.2/12*(3*0.006084+0.003249) = 0.000360 -->
      <!-- Izz = m/2*r^2 = 0.2/2*0.006084 = 0.000608 -->
      <origin xyz="0 0 0.028" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.000360" ixy="0.0" ixz="0.0"
        iyy="0.000360" iyz="0.0"
        izz="0.000608"/>
    </inertial>
  </link>

</robot>
